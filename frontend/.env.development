# Cấu hình cho môi trường dev (npm run dev)
# Vite tự nạp file này; không commit file .env.local (nếu có) lên git.

VITE_APP_NAME=ClassManagement

# Gọi API qua đường dẫn tương đối để Vite proxy chuyển tiếp sang backend.
VITE_API_BASE_URL=/api

# Backend ASP.NET Core đang chạy ở đâu trong lúc dev.
VITE_PROXY_TARGET=http://localhost:5080

# Cổng của Vite dev server.
VITE_PORT=5173

# Bật để xem log mọi request/response trong console trình duyệt.
VITE_API_DEBUG=true
